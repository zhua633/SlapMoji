# Optional override; next.config.ts defaults to Render production if unset.
NEXT_PUBLIC_API_URL=https://slapmoji-backend.onrender.com

# Server-only key for /api/effects/* proxy routes (Bearer token to the backend).
SLAPMOJI_API_KEY=

# Supabase (create a project at https://supabase.com/dashboard — local: run `supabase start` and copy API URL + anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
